# ============================================================
# Streamlit Secrets — copy this file to "secrets.toml" and fill in
# real values. The real secrets.toml is gitignored and NEVER pushed.
#
# For Streamlit Cloud deployment: paste these values into the
# "Secrets" web UI under your app's settings (no file needed).
# ============================================================

# Admin password — gates the Admin page in the app. Pick anything
# only you would guess. NOT the same as your DB password.
admin_password = "change-me-to-something-only-you-know"

# Postgres connection string from Neon (or any Postgres host).
# Leave this empty to use a local SQLite file instead (good for
# offline dev; data does NOT persist on Streamlit Cloud's free tier
# when using SQLite).
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
database_url = ""
